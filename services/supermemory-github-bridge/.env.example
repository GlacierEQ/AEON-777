# This service intentionally has no usable default credentials or allowlist.
# Supply every value through your deployment secret manager, never this file.
NODE_ENV=production
PORT=8080
BRIDGE_MODE=verify
BRIDGE_TRUST_PROXY=true
BRIDGE_POLICY_JSON=
BRIDGE_AGENT_SECRETS_JSON=
BRIDGE_APPROVER_SECRETS_JSON=
BRIDGE_SIGNING_SECRET=
BRIDGE_AUDIT_SIGNING_SECRET=
BRIDGE_LEDGER_DRIVER=sqlite
BRIDGE_LEDGER_PATH=/var/lib/supermemory-github-bridge/bridge.sqlite
SUPERMEMORY_API_KEY=
SUPERMEMORY_CONTAINER_TAG=sm_project_github
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_B64=
