{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:casebrain:schema:actor-profile-consumer-receipt:1.0.0",
  "title": "CASEBRAIN Pointer-Only Actor Profile Consumer Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "thread_anchor", "generated_at", "consumer", "subject", "candidate_envelopes", "guard_receipt", "raw_content_persisted"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "thread_anchor": { "const": "MEMORY_ARCHITECTURE__CASEBUILDER_4000__APEX_MEMORY_NEXUS__PR_51" },
    "generated_at": { "type": "string", "format": "date-time" },
    "consumer": { "const": "actor_profile_pointer" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "profile_status", "identity_status", "projection_mode"],
      "properties": {
        "actor_id": { "const": "actor-judge-natasha-shaw" },
        "profile_status": { "const": "conflict_review" },
        "identity_status": { "const": "conflicted" },
        "projection_mode": { "const": "pointer_only" }
      }
    },
    "candidate_envelopes": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "urn:casebrain:schema:connector-candidate-envelope:1.0.0" } },
    "guard_receipt": { "$ref": "urn:casebrain:schema:memory-retrieval-guard-receipt:1.0.0" },
    "raw_content_persisted": { "const": false }
  }
}
