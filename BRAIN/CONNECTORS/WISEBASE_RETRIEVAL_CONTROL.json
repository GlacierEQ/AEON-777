{
  "schema_version": "1.2.0",
  "status": "operative",
  "effective_at": "2026-07-29",
  "preservation_amended_at": "2026-07-29",
  "witness_journal_amended_at": "2026-07-29",
  "authority": {
    "wisebase_role": "candidate_retrieval_and_historical_research_plane",
    "canonical_memory_authority": "operator_designated_canonical_conversation",
    "source_fact_authority": "native_source_artifact_or_first_person_witness_source",
    "operator_controls_own_recollection_representation": true,
    "implementation_authority": "github",
    "governance_projection": [
      "notion",
      "task_systems"
    ]
  },
  "routing_domains": [
    "canonical_truth",
    "active_case_facts",
    "actor_event_threads",
    "machine_pistons",
    "witness_journal",
    "legacy_raw_corpus",
    "restricted_preserved_material"
  ],
  "source_preservation_policy": {
    "default_retention_decision": "preserve_raw",
    "preserve_original_language": true,
    "preserve_historical_voice": true,
    "preserve_timestamp": true,
    "preserve_provenance": true,
    "preserve_derivation_state": true,
    "preserve_moment_context": true,
    "quarantine_controls_access_not_retention": true,
    "failed_promotion_does_not_authorize_deletion": true,
    "supersession_is_append_only": true,
    "rewrite_legacy_source_prohibited": true,
    "delete_legacy_source_by_default_prohibited": true,
    "authorized_scope_searchability_preserved": true
  },
  "witness_journal_policy": {
    "first_person_account_is_evidence_bearing_source": true,
    "missing_connector_access_is_not_absence": true,
    "claimed_additional_support_must_be_preserved": true,
    "speaker_attribution_must_be_separated": true,
    "emotional_register_must_be_preserved": true,
    "repeated_entries_increase_chronological_salience": true,
    "repeated_entries_require_longitudinal_thread": true,
    "repetition_supports_continuity_notice_and_persistence_analysis": true,
    "repetition_alone_does_not_decide_external_conclusion": true,
    "observation_survives_dispute_over_legal_characterization": true,
    "derivatives_must_point_to_raw_source": true
  },
  "query_profiles": {
    "legal_record": {
      "required_anchor_types": [
        "case_id",
        "docket_or_record_id",
        "date_or_time_or_document_class"
      ],
      "minimum_exact_anchor_count": 3
    },
    "repository_state": {
      "required_anchor_types": [
        "repository",
        "object_id_or_path",
        "requested_state"
      ],
      "minimum_exact_anchor_count": 3
    },
    "architecture": {
      "must_split_broad_query": true,
      "approved_slices": [
        "source_hierarchy",
        "truth_taxonomy",
        "sensitivity_controls",
        "legacy_preservation",
        "witness_journal",
        "current_runtime_receipt",
        "project_identity",
        "connector_capability"
      ]
    },
    "historical_evolution": {
      "allows_contradictory_material": true,
      "allows_emotional_material": true,
      "allows_symbolic_material": true,
      "allows_incomplete_material": true,
      "allows_superseded_material": true,
      "minimum_exact_anchor_count": 2,
      "purpose": "longitudinal_understanding_not_current_fact_promotion"
    },
    "witness_journal": {
      "required_anchor_types": [
        "witness_or_speaker",
        "timeframe_or_source_pointer",
        "event_vector_or_journal_series"
      ],
      "minimum_exact_anchor_count": 3,
      "purpose": "preserve_and_link_first_person_account_chronology_and_support_state"
    }
  },
  "required_candidate_fields": [
    "candidate_id",
    "query",
    "query_profile",
    "exact_anchor_count",
    "source_name",
    "source_pointer",
    "raw_preservation_pointer",
    "source_retention_decision",
    "legacy_source",
    "captured_at",
    "moment_context_status",
    "speaker_attribution",
    "personal_knowledge_scope",
    "support_state",
    "claimed_additional_support",
    "journal_series_id",
    "occurrence_count",
    "event_vectors",
    "truth_class",
    "sensitivity",
    "proposition",
    "current_or_historical",
    "mutable_state",
    "current_run_receipt",
    "last_verified_at",
    "contradictions",
    "promotion_decision",
    "supersession_pointer",
    "rewrite_source",
    "deletion_requested",
    "duplicate_action",
    "exact_hash_verified",
    "project_identity_action",
    "source_proven_relationship",
    "remaining_gate"
  ],
  "allowed_truth_classes": [
    "verified_source_fact",
    "first_person_witness_statement",
    "contemporaneous_journal_entry",
    "documented_source_statement",
    "party_allegation",
    "third_party_statement",
    "lay_inference",
    "model_inference",
    "legal_characterization",
    "hypothesis",
    "runtime_state",
    "superseded_view",
    "unresolved"
  ],
  "allowed_support_states": [
    "support_not_currently_loaded",
    "support_pointer_known",
    "support_inaccessible_current_run",
    "corroboration_pending",
    "corroborated",
    "disputed",
    "unknown"
  ],
  "allowed_sensitivity_classes": [
    "public",
    "internal",
    "confidential",
    "restricted",
    "sealed"
  ],
  "allowed_source_retention_decisions": [
    "preserve_raw",
    "preserve_restricted"
  ],
  "restricted_content_classes": [
    "credential",
    "protected_minor_identifier",
    "medical_detail",
    "private_communication",
    "sensitive_accusation_requiring_controlled_exposure",
    "synthetic_anchor",
    "unqualified_legal_conclusion"
  ],
  "promotion_policy": {
    "relevance_alone_is_insufficient": true,
    "repetition_alone_is_insufficient_for_external_conclusion": true,
    "repetition_has_chronology_and_salience_value": true,
    "source_pointer_required": true,
    "truth_class_required": true,
    "sensitivity_required": true,
    "mutable_state_requires_current_run_receipt": true,
    "restricted_content_may_only_be_quarantined_for_promotion": true,
    "source_retention_is_independent_from_claim_promotion": true,
    "first_person_observation_must_not_be_discarded_for_missing_corroboration": true
  },
  "duplicate_policy": {
    "same_title_is_candidate_only": true,
    "same_size_is_candidate_only": true,
    "semantic_similarity_is_candidate_only": true,
    "consolidation_requires_exact_hash": true,
    "consolidation_requires_provenance_review": true,
    "originals_preserved_after_consolidation": true,
    "repeated_witness_entries_are_not_duplicate_noise": true
  },
  "project_identity_policy": {
    "merge_by_similarity_prohibited": true,
    "source_proven_relationship_required": true,
    "protected_distinct_identities": [
      "Megamind",
      "Mastermind",
      "AEON-777",
      "CASEBRAIN",
      "Echoes",
      "1FDA-23-0000515",
      "1FDV-23-0001009"
    ]
  },
  "partial_failure_policy": {
    "isolate_failed_slice": true,
    "mark_dependent_state_stale_or_unverified": true,
    "continue_unaffected_exact_source_probes": true,
    "return_exact_limitation": true
  },
  "connector_capability_boundary": {
    "supported": [
      "file_browser",
      "semantic_retrieval",
      "historical_research",
      "witness_journal_retrieval",
      "upload_interaction",
      "translation",
      "knowledge_graph_assets",
      "flashcard_assets",
      "quiz_assets",
      "video_explanation_assets"
    ],
    "not_exposed": [
      "source_file_rename",
      "source_file_tag",
      "source_file_delete",
      "collection_membership_change",
      "source_metadata_edit",
      "corpus_exclusion"
    ]
  }
}
