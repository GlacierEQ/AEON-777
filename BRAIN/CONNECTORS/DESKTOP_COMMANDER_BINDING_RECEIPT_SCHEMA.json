{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:casebrain:schema:desktop-commander-binding-receipt:1.1.0",
  "title": "CASEBRAIN Desktop Commander Principal Binding Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "thread_anchor",
    "receipt_id",
    "observed_at",
    "connector_id",
    "authentication",
    "device_probe",
    "binding",
    "routing",
    "raw_principal_identifiers_persisted",
    "raw_file_metadata_persisted"
  ],
  "properties": {
    "schema_version": { "const": "1.1.0" },
    "thread_anchor": { "const": "MEMORY_ARCHITECTURE__CASEBUILDER_4000__APEX_MEMORY_NEXUS__PR_51" },
    "receipt_id": { "type": "string", "pattern": "^desktop-commander-binding-[0-9]{4}-[0-9]{2}-[0-9]{2}-v[0-9]+$" },
    "observed_at": { "type": "string", "format": "date-time" },
    "connector_id": { "const": "desktop_commander" },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "principal_sha256", "backend_connected"],
      "properties": {
        "status": { "enum": ["authenticated", "unauthenticated"] },
        "principal_sha256": { "$ref": "#/$defs/sha256" },
        "backend_connected": { "type": "boolean" }
      }
    },
    "device_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "device_count", "online_device_count"],
      "properties": {
        "status": { "enum": ["success", "error"] },
        "device_count": { "type": "integer", "minimum": 0 },
        "online_device_count": { "type": "integer", "minimum": 0 }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["external_pairing_claim_present", "principal_match", "state"],
      "properties": {
        "external_pairing_claim_present": { "type": "boolean" },
        "principal_match": { "enum": ["unknown", "verified", "mismatch"] },
        "state": { "enum": ["split_principal_or_stale_registration", "verified", "unverified"] }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved_roots", "approved_root_real_paths", "read_allowed", "write_allowed", "decision", "next_gate"],
      "properties": {
        "approved_roots": { "type": "array", "items": { "$ref": "#/$defs/absolute_path" }, "uniqueItems": true },
        "approved_root_real_paths": { "type": "array", "items": { "$ref": "#/$defs/absolute_path" }, "uniqueItems": true },
        "read_allowed": { "type": "boolean" },
        "write_allowed": { "const": false },
        "decision": { "enum": ["blocked_no_bound_device", "blocked", "metadata_read_allowed"] },
        "next_gate": { "type": "string", "minLength": 8 }
      }
    },
    "raw_principal_identifiers_persisted": { "const": false },
    "raw_file_metadata_persisted": { "const": false }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "absolute_path": { "type": "string", "pattern": "^(?:/|[A-Za-z]:[\\\\/]).+" }
  }
}
