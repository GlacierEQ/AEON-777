{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:casebrain:schema:memory-backend-capability-probe:1.0.0",
  "title": "CASEBRAIN Memory Backend Capability Probe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "thread_anchor",
    "probe_id",
    "observed_at",
    "connector_id",
    "namespace",
    "graph_observation",
    "recall_observation",
    "mutation_interface",
    "deletion_contract",
    "raw_content_persisted"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "thread_anchor": { "const": "MEMORY_ARCHITECTURE__CASEBUILDER_4000__APEX_MEMORY_NEXUS__PR_51" },
    "probe_id": { "type": "string", "pattern": "^memory-capability-probe-[0-9]{4}-[0-9]{2}-[0-9]{2}-v[0-9]+$" },
    "observed_at": { "type": "string", "format": "date-time" },
    "connector_id": { "const": "supermemory" },
    "namespace": { "const": "sm_project_memory_master" },
    "graph_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_count", "memory_count", "document_ids_exposed", "chunk_ids_exposed"],
      "properties": {
        "document_count": { "type": "integer", "minimum": 0 },
        "memory_count": { "type": "integer", "minimum": 0 },
        "document_ids_exposed": { "const": false },
        "chunk_ids_exposed": { "const": false }
      }
    },
    "recall_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "retired_key_found", "stable_target_ids_exposed", "raw_response_persisted"],
      "properties": {
        "status": { "const": "success" },
        "retired_key_found": { "const": true },
        "stable_target_ids_exposed": { "const": false },
        "raw_response_persisted": { "const": false }
      }
    },
    "mutation_interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actions", "target_selector", "delete_by_id_supported", "delete_document_chunks_supported"],
      "properties": {
        "actions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [{ "const": "save" }, { "const": "forget" }],
          "items": false
        },
        "target_selector": { "const": "content_text_only" },
        "delete_by_id_supported": { "const": false },
        "delete_document_chunks_supported": { "const": false }
      }
    },
    "deletion_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physical_delete_claim_allowed", "negative_recall_confirmed", "logical_tombstone_required", "next_gate"],
      "properties": {
        "physical_delete_claim_allowed": { "const": false },
        "negative_recall_confirmed": { "const": false },
        "logical_tombstone_required": { "const": true },
        "next_gate": { "const": "stable_target_id_plus_delete_by_id_plus_immutable_receipt_plus_negative_recall" }
      }
    },
    "raw_content_persisted": { "const": false }
  }
}
