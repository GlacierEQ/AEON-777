{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:casebrain:schema:memory-backend-capability-probe:1.1.0",
  "title": "CASEBRAIN Memory Backend Capability Probe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "thread_anchor",
    "probe_id",
    "observed_at",
    "connector_id",
    "namespace",
    "graph_observation",
    "recall_observation",
    "mutation_interface",
    "deletion_contract",
    "raw_content_persisted"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "thread_anchor": {
      "const": "MEMORY_ARCHITECTURE__CASEBUILDER_4000__APEX_MEMORY_NEXUS__PR_51"
    },
    "probe_id": {
      "type": "string",
      "pattern": "^memory-capability-probe-[0-9]{4}-[0-9]{2}-[0-9]{2}-v[0-9]+$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "connector_id": {
      "const": "supermemory"
    },
    "namespace": {
      "const": "sm_project_memory_master"
    },
    "graph_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_count",
        "memory_count",
        "document_ids_exposed",
        "chunk_ids_exposed",
        "target_observations"
      ],
      "properties": {
        "document_count": {
          "type": "integer",
          "minimum": 0
        },
        "memory_count": {
          "type": "integer",
          "minimum": 0
        },
        "document_ids_exposed": {
          "type": "boolean"
        },
        "chunk_ids_exposed": {
          "type": "boolean"
        },
        "target_observations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target_id",
              "target_kind",
              "namespace",
              "observed_at",
              "addressable"
            ],
            "properties": {
              "target_id": {
                "type": "string",
                "minLength": 8
              },
              "target_kind": {
                "enum": [
                  "document",
                  "chunk",
                  "memory"
                ]
              },
              "namespace": {
                "const": "sm_project_memory_master"
              },
              "observed_at": {
                "type": "string",
                "format": "date-time"
              },
              "addressable": {
                "const": true
              }
            }
          }
        }
      }
    },
    "recall_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "retired_key_found",
        "stable_target_ids_exposed",
        "raw_response_persisted"
      ],
      "properties": {
        "status": {
          "const": "success"
        },
        "retired_key_found": {
          "type": "boolean"
        },
        "stable_target_ids_exposed": {
          "type": "boolean"
        },
        "raw_response_persisted": {
          "const": false
        }
      }
    },
    "mutation_interface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actions",
        "target_selector",
        "delete_by_id_supported",
        "delete_document_chunks_supported"
      ],
      "properties": {
        "actions": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "save",
              "forget",
              "delete_by_id"
            ]
          },
          "allOf": [
            {
              "contains": {
                "const": "save"
              }
            },
            {
              "contains": {
                "const": "forget"
              }
            }
          ]
        },
        "target_selector": {
          "enum": [
            "content_text_only",
            "stable_id"
          ]
        },
        "delete_by_id_supported": {
          "type": "boolean"
        },
        "delete_document_chunks_supported": {
          "type": "boolean"
        }
      }
    },
    "deletion_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physical_delete_claim_allowed",
        "negative_recall_confirmed",
        "logical_tombstone_required",
        "next_gate"
      ],
      "properties": {
        "physical_delete_claim_allowed": {
          "type": "boolean"
        },
        "negative_recall_confirmed": {
          "type": "boolean"
        },
        "logical_tombstone_required": {
          "type": "boolean"
        },
        "next_gate": {
          "enum": [
            "stable_target_id_plus_delete_by_id_plus_immutable_receipt_plus_negative_recall",
            "pre_delete_authorization"
          ]
        }
      }
    },
    "raw_content_persisted": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mutation_interface": {
            "properties": {
              "delete_by_id_supported": {
                "const": true
              }
            },
            "required": [
              "delete_by_id_supported"
            ],
            "type": "object"
          }
        },
        "type": "object"
      },
      "then": {
        "properties": {
          "graph_observation": {
            "properties": {
              "target_observations": {
                "minItems": 1,
                "type": "array"
              }
            },
            "anyOf": [
              {
                "properties": {
                  "document_ids_exposed": {
                    "const": true,
                    "type": "boolean"
                  }
                },
                "type": "object"
              },
              {
                "properties": {
                  "chunk_ids_exposed": {
                    "const": true,
                    "type": "boolean"
                  }
                },
                "type": "object"
              }
            ],
            "type": "object"
          },
          "recall_observation": {
            "properties": {
              "stable_target_ids_exposed": {
                "const": true,
                "type": "boolean"
              }
            },
            "type": "object"
          },
          "mutation_interface": {
            "properties": {
              "actions": {
                "contains": {
                  "const": "delete_by_id"
                },
                "type": "array"
              },
              "target_selector": {
                "const": "stable_id",
                "type": "string"
              }
            },
            "type": "object"
          },
          "deletion_contract": {
            "properties": {
              "physical_delete_claim_allowed": {
                "const": false,
                "type": "boolean"
              },
              "negative_recall_confirmed": {
                "const": false,
                "type": "boolean"
              },
              "logical_tombstone_required": {
                "const": true,
                "type": "boolean"
              },
              "next_gate": {
                "const": "pre_delete_authorization",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "else": {
        "properties": {
          "graph_observation": {
            "properties": {
              "target_observations": {
                "maxItems": 0,
                "type": "array"
              }
            },
            "type": "object"
          },
          "recall_observation": {
            "properties": {
              "stable_target_ids_exposed": {
                "const": false,
                "type": "boolean"
              }
            },
            "type": "object"
          },
          "mutation_interface": {
            "properties": {
              "target_selector": {
                "const": "content_text_only",
                "type": "string"
              }
            },
            "type": "object"
          },
          "deletion_contract": {
            "properties": {
              "physical_delete_claim_allowed": {
                "const": false,
                "type": "boolean"
              },
              "negative_recall_confirmed": {
                "const": false,
                "type": "boolean"
              },
              "logical_tombstone_required": {
                "const": true,
                "type": "boolean"
              },
              "next_gate": {
                "const": "stable_target_id_plus_delete_by_id_plus_immutable_receipt_plus_negative_recall",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    }
  ]
}
